{
  "name": "Huezel - Color Block Puzzle",
  "short_name": "Huezel",
  "description": "Glossy color block puzzle with Pure clears, guided stages, a weekly challenge, and no ads while you play.",
  "id": "/",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
